# =============================================================================
# unbork — Environment Variables Reference
# =============================================================================
# All settings can be provided as environment variables using the pattern:
#   UNBORK_<SECTION>__<KEY>=value
#
# To use: copy this file and fill in the required values.
#   cp .env.example dev/.env
#
# Settings can also be defined in dev/unbork.toml. Environment variables
# always override the TOML file.
#
# NOTE: Operational settings (log level, drift interval, SSH/Ansible timeouts,
# discovery tuning, audit retention) are managed via the Settings page in the
# UI and stored in the database — they do not belong here.
# =============================================================================


# =============================================================================
# REQUIRED — unbork refuses to start without these
# =============================================================================

# JWT signing key used to sign session tokens.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(64))"
UNBORK_SECURITY__SECRET_KEY=CHANGE_ME

# AES-256-GCM key for encrypting stored SSH private keys. Must decode to
# 32 bytes. Either standard or url-safe base64 is accepted.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# (or: openssl rand -base64 32)
UNBORK_SECURITY__ENCRYPTION_KEY=CHANGE_ME


# =============================================================================
# DATABASE
# =============================================================================

# PostgreSQL connection string.
UNBORK_DATABASE__URL=postgresql+asyncpg://unbork:unbork@localhost:5432/unbork

# Connection pool tuning (optional).
# UNBORK_DATABASE__POOL_SIZE=5
# UNBORK_DATABASE__MAX_OVERFLOW=10
# UNBORK_DATABASE__POOL_TIMEOUT=30


# =============================================================================
# REDIS
# =============================================================================

# Redis URL used by Celery workers and the RedBeat scheduler.
UNBORK_REDIS__URL=redis://localhost:6379/0


# =============================================================================
# SECURITY
# =============================================================================

# IP address unbork itself uses to reach managed hosts over SSH.
# Used to prevent unbork from locking itself out when generating firewall
# rules. Set to the host's LAN IP (not 127.0.0.1) in real deployments.
# UNBORK_SECURITY__UNBORK_SERVER_IP=192.168.1.10

# Allowed CORS origins — only needed when the frontend is served from a
# different origin than the API (e.g. local Next.js dev server).
# UNBORK_SECURITY__ALLOWED_ORIGINS=http://localhost:3000

# Mark session cookies as Secure. Set to true when serving over HTTPS.
# UNBORK_SECURITY__COOKIE_SECURE=true

# Cookie domain — set when the frontend and API are on different subdomains.
# UNBORK_SECURITY__COOKIE_DOMAIN=.example.com

# Session lifetime in seconds. Default is 24 hours.
# UNBORK_SECURITY__SESSION_LIFETIME_SECONDS=86400


# =============================================================================
# SERVER
# =============================================================================

# Bind address and port.
# UNBORK_SERVER__HOST=0.0.0.0
# UNBORK_SERVER__PORT=8000

# Absolute path to the compiled Next.js static export. Auto-detected when empty.
# Must be the directory that directly contains index.html — for a packaged
# install that is .../frontend/out, not .../frontend. Pointing one level too
# high makes the backend log "No frontend static directory found" and serve the
# API only, with a blank site and no other clue.
# UNBORK_SERVER__STATIC_DIR=/usr/lib/unbork/frontend/out

# IP(s) allowed to set X-Forwarded-For (space-separated). Set to your reverse
# proxy IP when running behind nginx/Caddy/Traefik.
# UNBORK_SERVER__FORWARDED_ALLOW_IPS=10.0.0.1


# =============================================================================
# TLS — only if terminating TLS at the app rather than a reverse proxy
# =============================================================================

# UNBORK_TLS__CERT_FILE=/etc/unbork/tls/fullchain.pem
# UNBORK_TLS__KEY_FILE=/etc/unbork/tls/privkey.pem
# UNBORK_TLS__FORCE_HTTPS=true


# =============================================================================
# RATE LIMITING
# =============================================================================

# UNBORK_RATE_LIMIT__ENABLED=true
# UNBORK_RATE_LIMIT__LOGIN=5/minute
# UNBORK_RATE_LIMIT__API=100/minute


# =============================================================================
# PROMETHEUS METRICS EXPORT
# =============================================================================

# Expose fleet state + unbork health at GET /metrics for Prometheus.
# Disabled by default. WHEN ENABLED THE ENDPOINT IS UNAUTHENTICATED --
# restrict it at your reverse proxy. See docs/metrics-export.md and
# docs/security-hardening.md.
# UNBORK_METRICS__ENABLED=true
# UNBORK_METRICS__CACHE_TTL_SECONDS=15.0
# UNBORK_METRICS__ACTION_KEY_LABEL=true


# =============================================================================
# LOGGING
# =============================================================================

# Structured JSON logging for log aggregators (e.g. Loki, Datadog).
# Log level and audit retention are configured in the UI Settings page.
# UNBORK_LOGGING__FORMAT=json


# =============================================================================
# SSH WEB TERMINAL
# =============================================================================

# Max concurrent terminal sessions (not SSH sync connections).
# UNBORK_SSH__MAX_SESSIONS_PER_USER=5
# UNBORK_SSH__MAX_TOTAL_SESSIONS=50
# UNBORK_SSH__DEFAULT_PORT=22


# =============================================================================
# CELERY WORKERS
# =============================================================================

# unbork runs two Celery workers: `work` (sync, drift, discovery and the
# per-host half of every action run) and `orchestrator`, which runs only
# action_orchestrator.run_action. They are separate because an orchestrator
# blocks waiting for the per-host children it dispatched, so sharing one pool
# with them deadlocks once enough runs start at the same time.

# Worker processes on the `work` pool.
# UNBORK_CELERY__CONCURRENCY=4

# Concurrent action runs the orchestrator worker will supervise. Exceeding it
# queues runs; it cannot deadlock. Raise it if many schedules share a cron
# minute — each slot costs a forked interpreter.
# UNBORK_CELERY__ORCHESTRATOR_CONCURRENCY=4

# Recycle a worker process after this many tasks (prevents memory leaks).
# UNBORK_CELERY__MAX_TASKS_PER_CHILD=100


# =============================================================================
# DISCOVERY
# =============================================================================

# Smallest prefix length allowed for scan CIDRs — prevents accidental sweeps
# of huge ranges. /20 = max 4094 addresses per scan.
# UNBORK_DISCOVERY__MIN_PREFIX=20

# Max hosts that can be bulk-added in a single operation.
# UNBORK_DISCOVERY__MAX_BULK_ADD=50


# =============================================================================
# DOCKER COMPOSE — used by dev/docker-compose.yml only
# =============================================================================

# Password for the local PostgreSQL container.
POSTGRES_PASSWORD=unbork
